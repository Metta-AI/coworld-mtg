+fn lock_batched_fixture_priority(r: &mut GameRunner) {
+    for actor in [P0, P1] {
+        engine::game::engine::apply(
+            r.state_mut(),
+            actor,
+            GameAction::SetFullControl {
+                mode: engine::types::game_state::FullControlMode::Locked,
