  if value.get("type")=="Unimplemented":result.append({"path":path,"node":value})
  for k,v in value.items():
   if k=="Unimplemented":result.append({"path":path+"."+k,"node":v})
   if k!="type":result.extend(explicit_nodes(v,path+"."+k))
 elif isinstance(value,list):
  for i,v in enumerate(value):result.extend(explicit_nodes(v,f"{path}[{i}]"))
 elif value=="Unimplemented":result.append({"path":path,"node":value})
 return result
